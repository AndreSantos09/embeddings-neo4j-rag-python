# ==================== Neo4j ====================
# Credenciais padrão do docker-compose (neo4j/password) — apenas para desenvolvimento local.
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=password

# ==================== Embeddings (locais / HuggingFace) ====================
# Modelo de embeddings executado localmente via sentence-transformers.
# Ex.: sentence-transformers/all-MiniLM-L6-v2 (384 dimensões, rápido)
#      Xenova/all-MiniLM-L6-v2 também funciona
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# ==================== LLM (OpenRouter / OpenAI-compatible) ====================
# Crie uma chave em https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Modelo a ser usado para gerar as respostas
NLP_MODEL=openai/gpt-4o-mini
# Cabeçalhos opcionais de identificação no OpenRouter
OPENROUTER_SITE_URL=http://localhost
OPENROUTER_SITE_NAME=embeddings-neo4j-rag-python
